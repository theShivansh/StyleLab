# --- secrets (kit shipped none of this; add BEFORE first commit) ---
.env
.env.*
!.env.example
*.pem
*.key
.claude/settings.local.json
.mcp.json

# --- node / next ---
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo
.turbo/
.vercel/

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# --- test artifacts ---
playwright-report/
test-results/
coverage/
blob-report/
tests/**/__screenshots__/*.actual.png

# --- local user images (privacy rule in docs/SECURITY-PRIVACY.md) ---
# `var/` is STORAGE_ROOT: uploaded garment photographs, private by default. It must never
# be committed, and it is not under a web root. `data/samples/` is the deliberate
# exception — a handful of photographs for the live suite, committed on purpose.
/storage/
/uploads/
var/
*.local.json

# --- local database (B12: no migrations yet, so create_all writes this file) ---
*.db
*.db-journal
*.sqlite3

# --- os ---
.DS_Store
Thumbs.db

# Assembled by deploy/hf-space/prepare.py. A copy of apps/api plus a Dockerfile, rebuilt on
# every run — committing it would be a second copy of the application that drifts from the
# first one silently.
deploy/hf-space/build/
